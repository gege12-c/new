# Supabase : URL du projet et clé publishable (paramètres du projet, clés d'API).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Adresse publique du site, sans « / » final (liens d'invitation, emails de confirmation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Activités réalisées (phase 3). Facultatif : sans ces variables, Strava est « non configuré »
# et seul l'import de fichiers FIT fonctionne. Valeurs à saisir côté serveur uniquement.

# Clé secrète Supabase (sb_secret_…) : file de synchronisation et jetons Strava, jamais dans une page.
SUPABASE_SECRET_KEY=

# Application Strava (strava.com/settings/api) : identifiant numérique et secret.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Clé de chiffrement des jetons OAuth : 32 octets en base64 (page Administration, ou `openssl rand -base64 32`).
TOKEN_ENCRYPTION_KEY=

# Secret des tâches planifiées Vercel (16 caractères au moins).
CRON_SECRET=

# Adresses de l'API Strava (facultatif) : la nouvelle adresse annoncée pour janvier 2027 se règle ici.
# STRAVA_API_BASE_URL=https://www.strava.com/api/v3
# STRAVA_OAUTH_BASE_URL=https://www.strava.com/oauth
