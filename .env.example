# Supabase : URL du projet et clé publishable (paramètres du projet, clés d'API).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Adresse publique du site, sans « / » final (liens d'invitation, emails de confirmation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Activités réalisées (phase 3). Facultatif : sans ces variables, Strava est « non configuré »
# et seul l'import de fichiers FIT fonctionne. Valeurs à saisir côté serveur uniquement.

# Clé secrète Supabase (sb_secret_…) : file de synchronisation et jetons Strava, jamais dans une page.
SUPABASE_SECRET_KEY=

# Application Strava (strava.com/settings/api) : identifiant numérique et secret.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Clé de chiffrement des jetons OAuth : 32 octets en base64 (page Administration, ou `openssl rand -base64 32`).
TOKEN_ENCRYPTION_KEY=

# Secret des tâches planifiées Vercel (16 caractères au moins).
CRON_SECRET=

# Adresses de l'API Strava (facultatif) : la nouvelle adresse annoncée pour janvier 2027 se règle ici.
# STRAVA_API_BASE_URL=https://www.strava.com/api/v3
# STRAVA_OAUTH_BASE_URL=https://www.strava.com/oauth

# --- Montre Suunto (envoi des séances comme guides SuuntoPlus). Facultatif : sans ces variables, Suunto
# est « non configuré » et seule la fiche « étapes Suunto » à recopier fonctionne. Valeurs de l'APIZone
# (apizone.suunto.com, après l'accès partenaire) ; TOKEN_ENCRYPTION_KEY et SUPABASE_SECRET_KEY servent aussi.
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=
# Nom exact de l'application sur l'APIZone : Suunto le vérifie comme propriétaire de chaque guide.
SUUNTO_APP_NAME=
# Facultatif : modes sportifs Suunto par discipline (identifiants du document Activities), ex. run:1,bike:2
# SUUNTO_ACTIVITIES=
# Adresses de l'API Suunto (tests uniquement).
# SUUNTO_API_BASE_URL=https://cloudapi.suunto.com
# SUUNTO_OAUTH_BASE_URL=https://cloudapi-oauth.suunto.com/oauth
